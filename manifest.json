{
  "manifest_version": 3,
  "name": "扩展管家",
  "version": "1.3.0",
  "description": "通过右键菜单与胶囊面板静默启用、禁用、卸载扩展，记忆扩展状态并支持网页视频后台持续播放",
  "icons": {
    "16": "icons/logo16.png",
    "48": "icons/logo_48.png",
    "128": "icons/logo_128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo16.png",
      "32": "icons/logo32.png"
    }
  },
  "permissions": [
    "contextMenus",
    "management",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}